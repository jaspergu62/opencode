FROM --platform=linux/amd64 oven/bun:1.3.14-alpine AS bun-runtime

FROM --platform=linux/amd64 node:22-alpine

ARG OPENCODE_VERSION=1.17.14
ARG RIPGREP_VERSION=14.1.1

ENV npm_config_prefix=/opt/pact-runtime

RUN apk add --no-cache ca-certificates curl xz

RUN mkdir -p /opt/pact-runtime/bin /opt/pact-runtime/lib \
    && cp /usr/local/bin/node /opt/pact-runtime/bin/node.bin \
    && cp -L /usr/lib/libstdc++.so.6 /opt/pact-runtime/lib/libstdc++.so.6 \
    && cp -L /usr/lib/libgcc_s.so.1 /opt/pact-runtime/lib/libgcc_s.so.1 \
    && printf '%s\n' '#!/bin/sh' \
      'LD_LIBRARY_PATH=/opt/pact-runtime/lib exec /opt/pact-runtime/bin/node.bin "$@"' \
      > /opt/pact-runtime/bin/node \
    && chmod +x /opt/pact-runtime/bin/node

COPY --from=bun-runtime /usr/local/bin/bun /opt/pact-runtime/bin/bun

RUN npm install --global "opencode-ai@${OPENCODE_VERSION}" \
    && curl -fsSL "https://github.com/BurntSushi/ripgrep/releases/download/${RIPGREP_VERSION}/ripgrep-${RIPGREP_VERSION}-x86_64-unknown-linux-musl.tar.gz" \
      | tar -xz --strip-components=1 -C /opt/pact-runtime/bin "ripgrep-${RIPGREP_VERSION}-x86_64-unknown-linux-musl/rg" \
    && /opt/pact-runtime/bin/node --version \
    && /opt/pact-runtime/bin/bun --version \
    && /opt/pact-runtime/bin/opencode --version \
    && /opt/pact-runtime/bin/rg --version
